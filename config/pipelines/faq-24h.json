{
  "name": "faq-24h",
  "description": "FAQ-сводка за сутки: топ-вопросы TG-чата с краткими ответами, экспорт в exports/ и допись секции в Wiki-FAQ.",
  "steps": [
    {
      "id": "s1",
      "tool": "mcp__tg__read_recent",
      "args": {
        "hours": 24,
        "max_messages": 500
      }
    },
    {
      "id": "s2",
      "tool": "mcp__tg__summary",
      "args": {
        "hours": 24
      }
    },
    {
      "id": "s3",
      "tool": "summarize",
      "args": {
        "text": "${steps.s2.result}",
        "instruction": "Выбери 5–10 самых популярных вопросов за сутки и краткие ответы из чата; формат: вопрос, ответ, частота"
      }
    },
    {
      "id": "s4",
      "tool": "saveToFile",
      "args": {
        "name": "faq-24h.md",
        "content": "${steps.s3.result}"
      }
    },
    {
      "id": "s5",
      "tool": "mcp__wiki__append_faq_page",
      "args": {
        "section_title": "Сводка за 24ч",
        "content": "${steps.s3.result}"
      }
    }
  ]
}
