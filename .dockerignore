# Git-обвязка и артефакты тестов — в образ не нужны
.git
.playwright-mcp
.gradle
build

# Зависимости фронтенда не тащим в контекст: npm ci в образе не выполняется
# (Node-стадии нет), dist копируется из контекста — НЕ исключать frontend/dist.
frontend/node_modules

# Python MCP-серверы: хост-артефакты и venv в образ не тащим. venv собирается
# в отдельной стадии (mcp-python), БД/буфер/кэш — только runtime-данные на хосте,
# echo/ — локальный артефакт. НЕ исключать сами .py (Dockerfile их копирует в финал).
mcp-servers/.venv/
mcp-servers/__pycache__/
mcp-servers/*.db*
mcp-servers/.tg_buffer.jsonl*
mcp-servers/.imported*
mcp-servers/.tg_messages.db*
mcp-servers/echo

# Служебное
*.log
.DS_Store
