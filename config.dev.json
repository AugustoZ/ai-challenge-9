{
  "port": 8080,
  "apiUrl": "http://127.0.0.1:18080/v1/chat/completions",
  "apiKey": "mock",
  "model": "mock-1",
  "allowedModels": ["mock-1"],
  "dataDir": "build/dev-data",
  "supportsTools": false,
  "tools": {
    "current_datetime": true,
    "calculator": true,
    "http_get": true,
    "run_code": {"enabled": false, "url": "http://tool-sandbox:8080", "timeoutSeconds": 30},
    "read_file": {"enabled": false, "url": "http://tool-sandbox:8080", "hostDir": "/Users/you/Downloads"},
    "write_file": {"enabled": false, "url": "http://tool-sandbox:8080", "hostDir": "/Users/you/Downloads"}
  },
  "mcp": [
    {
      "name": "echo",
      "command": "mcp-servers/.venv/bin/python",
      "args": ["src/test/resources/mcp/fake_echo_server.py"],
      "enabled": true
    }
  ],
  "providers": [
    {
      "id": "opencode",
      "name": "OpenCode Zen (бесплатные)",
      "type": "opencode",
      "apiUrl": "https://opencode.ai/zen/v1/chat/completions",
      "apiKey": "ВАШ_API_КЛЮЧ_OPENCODE_ZEN",
      "upstream": "opencode",
      "models": [
        "big-pickle",
        "ling-3.0-flash-fin-free",
        "mimo-v2.5-free",
        "nemotron-3.5-lightning-free",
        "nemotron-3-ultra-free"
      ]
    }
  ]
}
