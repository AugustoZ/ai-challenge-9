# === Секреты ===
# config.json — токен бота (TG_BOT_TOKEN). В git идёт только шаблон
# config.example.json (имя `config.json` его не задевает).
config.json
.env

# === Чувствительные данные: история переписки пользователей ===
# backups/ — архивные копии БД; .tg-db-share/ — живой снапшот для tg-sqlweb.
backups/
.tg-db-share/
*.db
*.db-shm
*.db-wal

# === Runtime-артефакты бота и стека ===
.tg_buffer.jsonl
.imported*
.*.pid
*.log
.day30-check.json

# === Python ===
.venv/
__pycache__/
*.pyc
*.pyo

# === Docker: локальные оверрайды ===
docker-compose.override.yml

# === ОС / редакторы ===
.DS_Store
Thumbs.db
