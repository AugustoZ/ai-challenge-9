# ---------- gw-club-indexer: runtime-образ ----------
# Одна стадия намеренна: проект — чистый питон (hatchling-колесо + PyPI-зависимости),
# ни нативных артефактов, ни фронтенд-диста — multi-stage добавил бы только
# сложность без выигрыша.
FROM python:3.12-slim

# uv закреплён на 0.12.7 — ровно версия хоста: формат uv.lock и поведение
# резолва совпадают с локальной средой разработки, поэтому сборка не
# пере-решает зависимости и не расходится с тем, что разработчик гоняет локально.
COPY --from=ghcr.io/astral-sh/uv:0.12.7 /uv /uvx /usr/local/bin/

WORKDIR /app

# Виртуальное окружение живёт вне /app (/opt/venv): в каталоге приложения
# остаются только исходники + лок — договор QA по содержимому образа; тот же
# путь затем находит `uv run` в рантайме.
ENV UV_PROJECT_ENVIRONMENT=/opt/venv

# Слой зависимостей — кэш: пересобирается только при изменении
# pyproject.toml или uv.lock.
# --frozen: не пере-решать — лок есть единственный источник правды
# (воспроизводимая сборка); --no-dev: pytest/ruff в рантайм не нужны.
# --no-install-project: само пакет проекта (hatchling-колесо из
# src/gwclub_indexer) ставится отдельно, после копирования исходников —
# в этом слое src/ в контексте ещё нет, и билд-бэкенд не смог бы собрать колесо.
COPY pyproject.toml uv.lock .
RUN uv sync --frozen --no-dev --no-install-project

# Исходники (их изменение не затрагивает кэш зависимостей).
COPY src ./src

# Ставим в готовое окружение само пакет проекта — к моменту запуска контейнера
# окружение полностью синхронно, и `uv run` просто стартует без билда и
# скачиваний.
RUN uv sync --frozen --no-dev

# Непривилегированный системный пользователь (без shell): контейнеру незачем
# root — портов ниже 1024 нет, системных путей не трогаем. Каталог HF-кэша
# готовим заранее и отдаём владельцу, чтобы модели (первый старт) ложились
# в домашний каталог пользователя, а не root'а, и compose мог примонтировать
# том в это же место. chown всего /home/indexer (а не только подкаталога
# huggingface): `uv run` в рантайме создаёт в home и свой кэш
# (.cache/uv), и root-owned home его бы отклонил (Permission denied).
# rm кэша uv/pip: после установки он только утяжеляет образ.
RUN useradd --system --no-create-home --shell /usr/sbin/nologin indexer \
    && mkdir -p /home/indexer/.cache/huggingface \
    && chown -R indexer:indexer /home/indexer /app /opt/venv \
    && rm -rf /root/.cache/uv /root/.cache/pip

# HF_HOME — модели sentence-transformers (~2.7 GB на первом старте) живут в
# домашнем каталоге пользователя, а не запекаются в образ; compose прикрутит
# сюда том, и кэш переживёт пересборку.
# TOKENIZERS_PARALLELISM=false — huggingface tokenizers форкит воркеры на
# параллельность, а в одном серверном процессе это приводит к дедлоку;
# рекомендация самой библиотеки.
# UV_NO_SYNC=1 — окружение в образе полное (зависимости + пакет проекта
# установлены на этапе сборки), поэтому `uv run` в рантайме не должен
# делать имплицитный ресинк: на свежем контейнере он заново билдит
# проект и докачивает колесо nvidia-cusparselt-cu13 (~210 MB) —
# каждый раз при перезапуске.
ENV HF_HOME=/home/indexer/.cache/huggingface TOKENIZERS_PARALLELISM=false UV_NO_SYNC=1

# Дальше всё выполняется от непривилегированного пользователя
USER indexer

# Порт поискового сервиса (compose запускает с --port 8000 — дефолт serve.py
# 18700 внутри контейнера не используется; см. CMD ниже).
EXPOSE 8000

# start-period 600s: при самом первом старте качаются модели (~2.7 GB) —
# без него healthcheck пометил бы контейнер unhealthy на всё время загрузки.
# python one-liner без curl: в python:slim нет curl, а ставить пакет ради
# проверки — лишнее; сокет-проверка достаточно для «сервис поднялся».
HEALTHCHECK --interval=15s --timeout=5s --start-period=600s --retries=5 \
    CMD python3 -c "import socket; socket.create_connection(('127.0.0.1',8000),timeout=3)"

# CMD-заглушка: реальную команду задаёт compose (передаёт --host 0.0.0.0 —
# serve.py по умолчанию биндится на 127.0.0.1, и порт контейнера был бы
# недоступен снаружи). Хост здесь намеренно не хардкодим.
CMD ["uv", "run", "gwclub", "serve", "--help"]
